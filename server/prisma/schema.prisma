// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  STAFF

  @@map("user_role")
}

enum PaymentMethod {
  CASH
  GCASH
  MAYA

  @@map("payment_method")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  receivedStockReceipts StockReceipt[]
  sales                 Sale[]

  @@map("users")
}

model Product {
  id           Int      @id @default(autoincrement())
  sku          String   @unique
  name         String
  category     String?
  sellingPrice Decimal  @map("selling_price") @db.Decimal(12, 2)
  reorderLevel Int      @default(0) @map("reorder_level")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  stockReceiptItems StockReceiptItem[]
  saleItems         SaleItem[]

  @@map("products")
}

model Supplier {
  id             Int      @id @default(autoincrement())
  name           String
  contactDetails String?  @map("contact_details")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  stockReceipts StockReceipt[]

  @@map("suppliers")
}

model StockReceipt {
  id          Int      @id @default(autoincrement())
  supplierId  Int      @map("supplier_id")
  referenceNo String?  @map("reference_no")
  receivedBy  Int      @map("received_by")
  receivedAt  DateTime @default(now()) @map("received_at") @db.Timestamptz()

  supplier       Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  receivedByUser User     @relation(fields: [receivedBy], references: [id], onDelete: Restrict)

  stockReceiptItems StockReceiptItem[]

  @@map("stock_receipts")
}

model StockReceiptItem {
  id        Int     @id @default(autoincrement())
  receiptId Int     @map("receipt_id")
  productId Int     @map("product_id")
  quantity  Int
  unitCost  Decimal @map("unit_cost") @db.Decimal(12, 2)

  receipt StockReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  product Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([receiptId, productId])
  @@map("stock_receipt_items")
}

model Sale {
  id            Int           @id @default(autoincrement())
  recordedBy    Int           @map("recorded_by")
  totalAmount   Decimal       @map("total_amount") @db.Decimal(12, 2)
  paymentMethod PaymentMethod @map("payment_method")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz()

  recordedByUser User       @relation(fields: [recordedBy], references: [id], onDelete: Restrict)
  saleItems      SaleItem[]

  @@map("sales")
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int     @map("sale_id")
  productId Int     @map("product_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([saleId, productId])
  @@map("sale_items")
}
