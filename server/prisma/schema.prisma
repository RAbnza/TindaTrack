// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  STAFF

  @@map("user_role")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  receivedStockReceipts StockReceipt[]

  @@map("users")
}

model Product {
  id           Int      @id @default(autoincrement())
  sku          String   @unique
  name         String
  category     String?
  sellingPrice Decimal  @map("selling_price") @db.Decimal(12, 2)
  reorderLevel Int      @default(0) @map("reorder_level")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("products")
}

model Supplier {
  id             Int      @id @default(autoincrement())
  name           String
  contactDetails String?  @map("contact_details")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  stockReceipts StockReceipt[]

  @@map("suppliers")
}

model StockReceipt {
  id          Int      @id @default(autoincrement())
  supplierId  Int      @map("supplier_id")
  referenceNo String?  @map("reference_no")
  receivedBy  Int      @map("received_by")
  receivedAt  DateTime @default(now()) @map("received_at") @db.Timestamptz()

  supplier       Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  receivedByUser User     @relation(fields: [receivedBy], references: [id], onDelete: Restrict)

  @@map("stock_receipts")
}
