# PostgreSQL connection string.
#
# Development example:
# postgresql://postgres:password@localhost:5432/tindatrack_dev
#
# In production, use the connection string supplied
# by the managed PostgreSQL provider.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tindatrack_dev"

# Used to sign and verify authentication tokens.
# Use a long, random secret in production.
# Minimum length: 32 characters.
JWT_SECRET="replace-this-with-a-long-random-secret-at-least-32-characters"

# Express port.
# Most hosting providers inject this automatically.
PORT=3000

# Browser origin allowed to call the API.
#
# Development:
CLIENT_ORIGIN="http://localhost:5173"

# Production example:
# CLIENT_ORIGIN="https://tindatrack.example.com"